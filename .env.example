# =============================================================================
# Frontend LOCAL / development template
# Copy to `.env.local` (gitignored).
#
# Production / Railway values live in GitHub Actions secrets
# (repo: rennovatetechnologies/india-exports-hub-53) — same names.
# Vite inlines VITE_* at **build** time, so Railway must have these as
# service variables before `npm run build`.
# =============================================================================

# false = talk to Express via Vite /api proxy (http://127.0.0.1:5001)
VITE_ALLOW_AUTH_MOCK=false

# Leave empty locally so fetch('/api/...') uses the Vite proxy.
VITE_API_BASE_URL=

# Optional Razorpay publishable key fallback (prefer GET /api/config/public)
# Local/dev: TEST key. Production: LIVE key in `.env.production` / Railway.
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
