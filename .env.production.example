# =============================================================================
# Frontend PRODUCTION / Railway template
# Real values are GitHub Actions secrets (same names) and Railway variables.
# Vite bakes VITE_* into the bundle at build time.
# =============================================================================

VITE_ALLOW_AUTH_MOCK=false

# Public HTTPS URL of the backend Railway service (no trailing slash).
VITE_API_BASE_URL=https://new-india-exports-production.up.railway.app

# Razorpay publishable LIVE key (safe in the browser bundle). Secret stays on the backend.
VITE_RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
